# ── сайт ──
APP_URL="https://flix-market.com"
# Домени, з яких дозволено логін / CORS (через кому). www підхопиться сам від APP_URL.
SITE_ORIGINS="https://flix-market.com,https://www.flix-market.com,https://market.easyplayy.com"
# Спільна cookie між apex і www
COOKIE_DOMAIN=".flix-market.com"
COOKIE_SECURE="1"
SESSION_SECRET="згенеруй: openssl rand -base64 48"
SITE_BACKEND_URL="http://127.0.0.1:8000"

# ── API бота (сайт і бот на РІЗНИХ серверах — обовʼязково публічний URL) ──
# Один VPS: http://127.0.0.1:8088
# Різні VPS: https://market.easyplayy.com  (nginx проксі /api/v1/ → :8088, див. FlixMarketBot/deploy/)
# Альтернатива: BOT_PUBLIC_API_URL якщо BOT_API_URL залишився localhost
BOT_API_URL="https://market.easyplayy.com"
BOT_API_KEY=""

# ── мініапка (каталог / фото / категорії) ──
MINIAPP_API_URL="https://market.easyplayy.com"

# ── Monobank (рахунок створює сайт; вебхук — на API бота) ──
MONO_XTOKEN=""

# ── Telegram (той самий токен, що BOT_TOKEN у FlixMarketBot) ──
# ВАЖЛИВО: не дублюй TELEGRAM_BOT_TOKEN внизу файлу — порожній рядок перезапише токен!
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_NAME="FlixMarketBot"

# ── пошта ──
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="flixмаркет <hello@flix-market.com>"

# ── адмінка сайту ──
ADMIN_TELEGRAM_IDS="123456789"
ADMIN_EMAILS="vlad@mail.com"
