generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  emailVerified DateTime?
  passwordHash  String?
  telegramId    BigInt?  @unique
  telegramName  String?
  isAdmin       Boolean  @default(false)
  /// Останній IP входу — сповіщення шлеться лише коли він змінився
  lastLoginIp   String?
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())

  orders        Order[]
  subscriptions Subscription[]
  tokens        Token[]

  @@index([createdAt])
}

/// Одноразові токени: підтвердження пошти, скидання пароля, привʼязка Telegram
model Token {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      TokenKind
  value     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
}

enum TokenKind {
  EMAIL_VERIFY
  PASSWORD_RESET
  TELEGRAM_LINK
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  /// Емодзі (🍿) або slug Simple Icons (openai) — визначається автоматично
  icon      String    @default("")
  color     String    @default("#2B5CF6")
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  products  Product[]

  @@index([active, sortOrder])
}

/// Вітрина: те, що бачить клієнт у каталозі
model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  icon        String   @default("")   // slug Simple Icons
  color       String   @default("#2B5CF6")
  description String   @default("")
  features    String   @default("")   // по рядку на пункт
  /// Ціна за місяць — використовується для помісячного товару з автопродовженням
  price       Int
  days        Int      @default(30)   // довжина одного місяця в днях
  /// Ціни за строк, у копійках. Нуль — строк не продається.
  price3      Int      @default(0)
  price6      Int      @default(0)
  price12     Int      @default(0)
  /// Часті питання: блоки через порожній рядок, перший рядок блоку — питання
  faq         String   @default("")
  /// Один рядок під кнопкою оплати: строк видачі, умови
  deliveryNote String  @default("")
  visible     Boolean  @default(true)
  autoIssue   Boolean  @default(true)
  /// Помісячна підписка з автопродовженням: строк не обирається, списання щомісяця
  recurring   Boolean  @default(false)
  sortOrder   Int      @default(0)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  credentials Credential[]
  orders      Order[]
  subs        Subscription[]

  @@index([visible, sortOrder])
}

/// Склад: реальні акаунти зі слотами
model Credential {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  login      String
  secretEnc  String                    // пароль, AES-256-GCM
  totpEnc    String?                   // base32 секрет 2FA, AES-256-GCM
  slotsTotal Int      @default(1)
  slotsUsed  Int      @default(0)
  validUntil DateTime?
  note       String   @default("")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  subs       Subscription[]

  @@index([productId, active])
}

model Order {
  id         String      @id @default(cuid())
  ref        String      @unique          // людський номер, він же reference для Mono
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  months     Int         @default(1)
  amount     Int                          // копійки, фінальна сума
  promoCode  String?
  status     OrderStatus @default(PENDING)
  invoiceId  String?     @unique          // id інвойсу Monobank
  paidAt     DateTime?
  createdAt  DateTime    @default(now())

  subscription Subscription?

  @@index([userId, createdAt])
  @@index([status])
}

enum OrderStatus {
  PENDING     // створено, чекаємо оплату
  PAID        // гроші прийшли, доступ ще не видано
  DELIVERED   // доступ видано
  FAILED
  REFUNDED
}

model Subscription {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  orderId      String?   @unique
  order        Order?    @relation(fields: [orderId], references: [id])
  credentialId String?
  credential   Credential? @relation(fields: [credentialId], references: [id])
  profileName  String?
  pin          String?
  startsAt     DateTime  @default(now())
  expiresAt    DateTime
  status       SubStatus @default(ACTIVE)
  source       String    @default("site")  // site | bot
  createdAt    DateTime  @default(now())

  @@index([userId, status])
  @@index([expiresAt, status])
}

enum SubStatus {
  ACTIVE
  EXPIRED
  REPLACED
  CANCELLED
}

model Promo {
  id         String   @id @default(cuid())
  code       String   @unique
  percentOff Int      @default(0)
  fixedOff   Int      @default(0)   // копійки
  maxUses    Int      @default(0)   // 0 = без обмеження
  uses       Int      @default(0)
  firstOnly  Boolean  @default(false)
  productId  String?
  validUntil DateTime?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

/// Ліміт на видачу 2FA-кодів і слід для розборів
model CodeLog {
  id             String   @id @default(cuid())
  subscriptionId String
  userId         String
  ip             String   @default("")
  createdAt      DateTime @default(now())

  @@index([subscriptionId, createdAt])
  @@index([userId, createdAt])
}

model Setting {
  key   String @id
  value String
}
